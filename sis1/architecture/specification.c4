specification {
  color ink #111111
  color paper #FFFFFF

  element person {
    style {
      shape person
      color paper
    }
  }
  element system {
    style { color ink }
  }
  element external {
    style { color paper }
  }
  element gateway {
    style { color ink }
  }
  element service {
    style { color ink }
  }
  element component {
    style { color ink }
  }
  element database {
    style {
      shape storage
      color ink
    }
  }
  element table {
    style {
      shape storage
      color paper
    }
  }
  element key {
    style {
      shape storage
      color paper
    }
  }
  element queue {
    style {
      shape queue
      color ink
    }
  }
  element topic {
    style {
      shape queue
      color paper
    }
  }
  element tool {
    style { color paper }
  }

  relationship rest {
    color gray
    line dashed
  }
  relationship grpc {
    color gray
    line solid
  }
  relationship async {
    color gray
    line dotted
  }

  tag sis2
  tag planned

  deploymentNode environment
  deploymentNode zone
  deploymentNode cluster
  deploymentNode container
}

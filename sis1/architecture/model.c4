model {
  user = person 'User App' {
    description 'Web / Mobile. Лайк и снятие лайка, просмотр поста, счётчики ленты. Optimistic +1 после лайка.'
  }
  operator = person 'SRE / оператор' {
    description 'Consumer lag, failover, восстановление Redis из БД и Kafka.'
  }
  idp = external 'Identity provider' {
    technology 'OIDC · JWT'
    description 'Выдаёт access token. Claim sub — стабильный user_id.'
  }
  bench = tool 'Bench harness' {
    #sis2
    technology 'Python 3.12 · grpc.aio · httpx · hdrhistogram'
    description 'Один генератор нагрузки для gRPC и REST/JSON: одинаковые сценарии, конкурентность и прогрев. По процессу на ядро, чтобы клиент не стал узким местом.'
  }

  platform = system 'Like & View Counter' {
    description 'Regional backend. 20 000 инкрементов/с, 44 000 чтений/с, 50 млн постов. Счётчик виден ≤ 2 с, чтение p99 < 50 мс, 99,99%.'

    gateway = gateway 'API Gateway' {
      technology 'Envoy · LB · TLS'
      description 'JWT → user_id. Rate limit (429). REST/JSON снаружи → gRPC внутрь. Ретраи с retry budget.'
    }

    writeSvc = service 'Write Service' {
      #sis2
      technology 'Python 3.12 · grpc.aio + FastAPI · uvloop · stateless'
      description 'Лайк, снятие лайка, view_started и view_finished. Проверяет view token, дедуплицирует просмотр, публикует событие в Kafka.'

      likeHandler = component 'Like / Unlike' {
        #sis2
        technology 'SetLike · RemoveLike'
        description 'Идемпотентны по смыслу: задают состояние, а не прибавляют. event_id = UUIDv7 из Idempotency-Key.'
      }
      viewTokens = component 'View token' {
        #sis2
        technology 'HMAC-SHA256'
        description 'StartView выдаёт подписанный token {jti, user_id, post_id, started_at, min_ms}. FinishView проверяет подпись, user_id и прошедшее время.'
      }
      viewDedup = component 'View dedup' {
        #sis2
        technology 'redis.asyncio · SET NX EX 3600'
        description 'Новый ключ view:{post_id}:{user_id} → событие. Ключ уже есть → 200 OK без события.'
      }
      publisher = component 'Event publisher' {
        #sis2
        technology 'aiokafka · acks=all · idempotence'
        description 'Ключ партиции post_id. Ждёт ack не дольше остатка deadline. Нет ack → откат dedup-ключа и UNAVAILABLE.'
      }
    }

    readSvc = service 'Read Service' {
      #sis2
      technology 'Python 3.12 · grpc.aio + FastAPI · uvloop · stateless'
      description 'Счётчики поста и пакет счётчиков для ленты, liked_by_me.'

      countersQuery = component 'Counters query' {
        #sis2
        technology 'GetCounters · BatchGetCounters ≤ 100'
        description 'Собирает ответ из локального кэша, Redis и БД.'
      }
      localCache = component 'Hot post cache' {
        #sis2
        technology 'cachetools.TTLCache · TTL 500 мс'
        description 'Горячие посты читаются из памяти пода. 500 мс вместо 1 с — чтобы окно агрегации 1 с + кэш уложились в 2 с.'
      }
      likedByMe = component 'liked_by_me' {
        #sis2
        technology 'asyncpg · PK lookup'
        description 'SELECT по (post_id, user_id) на шардах постов пакета. Для ленты — один запрос на шард.'
      }
    }

    kafka = queue 'Kafka' {
      technology '3+ brokers · RF 3 · min ISR 2'
      description 'Буфер между приёмом и подсчётом. Ключ post_id: все события поста попадают в одну партицию и к одному агрегатору.'

      events = topic 'engagement-events' {
        technology 'Партиции по post_id · retention 7 суток'
        description 'event_id UUID (16 Б) · type like/unlike/view (1 Б) · post_id (8 Б) · user_id (8 Б) · timestamp (8 Б).'
      }
      dlq = topic 'engagement-events.dlq' {
        technology 'retention 14 суток'
        description 'Нечитаемые события. Не блокируют партицию.'
      }
    }

    aggregator = service 'Aggregator Workers' {
      technology 'Python 3.12 · aiokafka · consumer group'
      description 'Окно 1 с: суммирует +N в памяти по посту. Лайки сразу пишет в БД, просмотры — в Redis, снимок в БД каждые 10–30 с.'

      consumer = component 'Partition consumer' {
        technology 'poll() · enable.auto.commit=false'
        description 'Партиция → ровно один агрегатор, поэтому гонок по одному посту нет.'
      }
      likeApplier = component 'Like applier' {
        technology 'Транзакция на шард'
        description 'INSERT … ON CONFLICT DO NOTHING / DELETE … RETURNING. likes_count += Δ RETURNING → HSET в Redis абсолютным значением.'
      }
      viewAggregator = component 'View aggregator' {
        technology 'Окно 1 с · Lua на слот поста'
        description 'Атомарно в Redis: SET NX evt:{post_id}:{event_id} + HINCRBY views. Повтор события → 0.'
      }
      flusher = component 'Snapshot flusher' {
        technology 'Каждые 10–30 с'
        description 'Пишет views_count абсолютным значением из Redis в post_counters, затем commit offsets.'
      }
    }

    redis = database 'Redis Cluster' {
      technology 'Redis 7.4 · шарды по post_id · replica на шард'
      description 'Главное хранилище чтений: все 50 млн счётчиков в памяти, чтение 1–2 мс. allkeys-lru только как страховка.'

      counterKey = key 'counter:{post_id}' {
        technology 'HASH {likes, views} · без TTL'
        description '50 млн × 100 Б ≈ 5 ГБ.'
      }
      viewKey = key 'view:{post_id}:{user_id}' {
        technology 'STRING · TTL 1 ч'
        description 'Дедупликация просмотров. 18 000/с × 3600 с × 100 Б ≈ 6,5 ГБ.'
      }
      eventKey = key 'evt:{post_id}:{event_id}' {
        technology 'STRING · TTL 1 ч'
        description 'Защита от повторной доставки Kafka. Хеш-тег {post_id} держит ключ в слоте счётчика.'
      }
    }

    db = database 'Database' {
      technology 'PostgreSQL 17 · шарды по post_id · primary + replica'
      description 'Источник истины для лайков. Снимок счётчиков для восстановления Redis.'

      likes = table 'likes' {
        technology 'PK (post_id, user_id) · ≈ 50 Б/строка'
        description 'post_id, user_id, created_at. Один лайк на пару. Рост ≈ 8 ГБ/сутки, ≈ 3 ТБ/год.'
      }
      postCounters = table 'post_counters' {
        technology 'PK post_id · ≈ 50 Б/строка'
        description 'likes_count, views_count, updated_at. 50 млн × 50 Б ≈ 2,5 ГБ.'
      }
    }

    observability = service 'Observability' {
      #planned
      technology 'Prometheus · Grafana · OpenTelemetry'
      description 'Consumer lag, возраст события, p99 по методам и кодам, retry rate, hit rate.'
    }
  }

  // Клиент и край
  user -> idp 'Вход' {
    technology 'OIDC'
  }
  user -[rest]-> platform.gateway 'Лайк, просмотр, счётчики' {
    technology 'HTTPS · REST/JSON'
  }
  platform.gateway -> idp 'JWKS'
  platform.gateway -[grpc]-> platform.writeSvc 'like / view' {
    technology 'gRPC · HTTP/2 · deadline 300 мс'
  }
  platform.gateway -[grpc]-> platform.readSvc 'get counters' {
    technology 'gRPC · HTTP/2 · deadline 100 мс'
  }
  bench -[grpc]-> platform.writeSvc 'Сценарии нагрузки' {
    technology 'gRPC'
  }
  bench -[rest]-> platform.writeSvc 'Те же сценарии' {
    technology 'REST/JSON'
  }
  bench -[grpc]-> platform.readSvc 'BatchGetCounters' {
    technology 'gRPC'
  }
  bench -[rest]-> platform.readSvc 'GET /counters' {
    technology 'REST/JSON'
  }

  // Write Service
  platform.writeSvc.likeHandler -> platform.writeSvc.publisher 'like / unlike'
  platform.writeSvc.viewTokens -> platform.writeSvc.viewDedup 'Токен валиден'
  platform.writeSvc.viewDedup -> platform.redis.viewKey 'SET NX EX 3600' {
    technology 'RESP · 20 мс'
  }
  platform.writeSvc.viewDedup -> platform.writeSvc.publisher 'Новый просмотр'
  platform.writeSvc.publisher -[async]-> platform.kafka.events 'event · acks=all' {
    technology 'Kafka protocol'
  }

  // Read Service
  platform.readSvc.countersQuery -> platform.readSvc.localCache 'Горячие посты'
  platform.readSvc.countersQuery -> platform.redis.counterKey 'HGETALL · pipeline' {
    technology 'RESP · 20 мс'
  }
  platform.readSvc.countersQuery -> platform.db.postCounters 'Cache miss' {
    technology 'asyncpg · replica · 50 мс'
  }
  platform.readSvc.countersQuery -> platform.readSvc.likedByMe 'Для авторизованного'
  platform.readSvc.likedByMe -> platform.db.likes 'PK lookup' {
    technology 'asyncpg · replica'
  }

  // Aggregator
  platform.kafka.events -[async]-> platform.aggregator.consumer 'consume'
  platform.aggregator.consumer -> platform.aggregator.likeApplier 'like / unlike'
  platform.aggregator.consumer -> platform.aggregator.viewAggregator 'view'
  platform.aggregator.likeApplier -> platform.db.likes 'insert / delete RETURNING' {
    technology 'asyncpg · транзакция на шард'
  }
  platform.aggregator.likeApplier -> platform.db.postCounters 'likes_count += Δ RETURNING'
  platform.aggregator.likeApplier -> platform.redis.counterKey 'HSET likes = значение БД'
  platform.aggregator.viewAggregator -> platform.redis.eventKey 'SET NX'
  platform.aggregator.viewAggregator -> platform.redis.counterKey 'HINCRBY views (окно 1 с)'
  platform.aggregator.flusher -> platform.redis.counterKey 'HGET views'
  platform.aggregator.flusher -> platform.db.postCounters 'views_count = снимок · 10–30 с'
  platform.aggregator.flusher -[async]-> platform.kafka.events 'commit offsets'
  platform.aggregator.consumer -[async]-> platform.kafka.dlq 'Нечитаемые события'

  // Данные
  platform.db.likes -> platform.db.postCounters 'post_id'

  // Эксплуатация
  operator -> platform.observability 'Дашборды и алерты'
  platform.observability -> platform.aggregator 'Lag · event age'
  platform.observability -> platform.writeSvc 'p99 · коды'
  platform.observability -> platform.readSvc 'p99 · hit rate'
}

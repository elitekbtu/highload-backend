views {
  dynamic view view_flow {
    title '09 · Сценарии / Просмотр'
    description 'Пост виден на экране → view_started → подпись токена → ожидание 2 с (20 с для видео) → view_finished → проверка → SET NX → Kafka → +1. Пролистанный пост стоит только одного запроса.'
    variant sequence
    user -> platform.gateway 'POST /posts/{id}/view_started'
    platform.gateway -> platform.writeSvc 'StartView'
    platform.gateway <- platform.writeSvc 'view_token {jti, user, post, started_at, min_ms}'
    user <- platform.gateway '200 { view_token }'
    user -> user 'Пост на экране ≥ 2 с (видео ≥ 20 с)'
    user -> platform.gateway 'POST /posts/{id}/view_finished + token'
    platform.gateway -> platform.writeSvc 'FinishView'
    platform.writeSvc -> platform.writeSvc 'Подпись, user_id, now − started_at ≥ min_ms' {
      notes 'Иначе FAILED_PRECONDITION → 400 Bad Request.'
    }
    platform.writeSvc -> platform.redis 'SET NX view:{post}:{user} EX 3600'
    platform.writeSvc -> platform.kafka.events 'Ключ новый → view · event_id = UUIDv5(jti)' {
      notes 'Ключ уже есть → 200 OK без события.'
    }
    platform.writeSvc <- platform.kafka.events 'ack'
    user <- platform.gateway '202 Accepted'
    platform.kafka.events -> platform.aggregator 'consume'
    platform.aggregator -> platform.redis 'Окно 1 с: SET NX evt + HINCRBY views'
  }

  dynamic view like_flow {
    title '09 · Сценарии / Лайк'
    description 'Клиент сразу показывает +1. Точность обеспечивает транзакция агрегатора: Δ считается по фактически вставленным строкам, а в Redis пишется значение из БД.'
    variant sequence
    user -> platform.gateway 'PUT /posts/{id}/like'
    platform.gateway -> platform.writeSvc 'SetLike · deadline 300 мс'
    platform.writeSvc -> platform.kafka.events 'like · key post_id'
    platform.writeSvc <- platform.kafka.events 'ack'
    user <- platform.gateway '202 Accepted'
    platform.kafka.events -> platform.aggregator 'Пакет окна 1 с'
    platform.aggregator -> platform.db 'BEGIN · INSERT likes ON CONFLICT DO NOTHING RETURNING'
    platform.aggregator -> platform.db 'likes_count += Δ RETURNING likes_count · COMMIT'
    platform.aggregator -> platform.redis 'HSET counter:{post} likes = значение БД'
  }

  dynamic view read_flow {
    title '09 · Сценарии / Счётчики ленты'
    description 'Один запрос на ленту. Промахи Redis и liked_by_me — по одному запросу на шард.'
    variant sequence
    user -> platform.gateway 'GET /counters?post_ids=…20'
    platform.gateway -> platform.readSvc 'BatchGetCounters · deadline 100 мс'
    platform.readSvc -> platform.readSvc 'Локальный кэш горячих постов'
    platform.readSvc -> platform.redis 'Pipeline HGETALL × остальные'
    platform.readSvc -> platform.db 'Промахи: SELECT post_counters WHERE post_id = ANY(…)'
    platform.readSvc -> platform.redis 'Промахи: записать обратно'
    platform.readSvc -> platform.db 'liked_by_me · PK lookup на шард'
    platform.gateway <- platform.readSvc 'counters[]'
    user <- platform.gateway '200 { counters: [...] }'
  }

  dynamic view view_retry {
    title '09 · Сценарии / Таймаут Kafka и повтор'
    description 'Исход первой отправки неизвестен. Откат dedup-ключа разрешает повтор, а детерминированный event_id не даёт посчитать просмотр дважды.'
    variant sequence
    platform.gateway -> platform.writeSvc 'FinishView · попытка 1'
    platform.writeSvc -> platform.redis 'SET NX view-ключ · OK'
    platform.writeSvc -> platform.kafka.events 'send event_id E'
    platform.writeSvc -> platform.writeSvc 'Нет ack за 200 мс'
    platform.writeSvc -> platform.redis 'DEL view-ключ'
    platform.gateway <- platform.writeSvc 'UNAVAILABLE'
    platform.gateway -> platform.writeSvc 'Попытка 2 через backoff · тот же token'
    platform.writeSvc -> platform.redis 'SET NX · OK'
    platform.writeSvc -> platform.kafka.events 'send event_id E · ack'
    platform.gateway <- platform.writeSvc 'OK → 202'
    platform.kafka.events -> platform.aggregator 'E дважды'
    platform.aggregator -> platform.redis 'SET NX evt:{post}:E — первый +1, второй 0'
  }

  dynamic view aggregator_replay {
    title '09 · Сценарии / Сбой агрегатора'
    description 'Offsets закоммичены по последний снимок. Новый владелец партиции повторяет события после него, и результат не меняется.'
    variant sequence
    platform.kafka.events -> platform.aggregator 'События после снимка'
    platform.aggregator -> platform.redis 'HINCRBY views · HSET likes'
    platform.aggregator -> platform.aggregator 'Сбой до снимка и commit'
    platform.kafka.events -> platform.aggregator 'Те же события новому владельцу'
    platform.aggregator -> platform.db 'Лайки: ON CONFLICT → Δ = 0'
    platform.aggregator -> platform.redis 'Просмотры: evt-ключи есть → 0'
    platform.aggregator -> platform.db 'Снимок views_count'
    platform.aggregator -> platform.kafka.events 'commit offsets'
  }
}
